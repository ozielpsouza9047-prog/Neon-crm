rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if data belongs to the requested store or matches valid tenant rules
    function isOwner() {
      return isAuthenticated();
    }

    // Stores collection: readable by anyone (for public storefronts), writable only by authenticated admin/owner
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Clients collection: strictly scoped to authenticated owners
    match /clients/{clientId} {
      allow read, write: if isAuthenticated();
    }

    // Appointments collection: public can create with strict validation (status must be Pendente), authenticated users can read/update/delete
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated();
      allow create: if request.resource.data.status == 'Pendente' 
                    && request.resource.data.clientName is string 
                    && request.resource.data.clientName.size() > 0
                    && request.resource.data.service is string;
      allow update, delete: if isAuthenticated();
    }

    // Sales collection: strictly scoped to authenticated owners
    match /sales/{saleId} {
      allow read, write: if isAuthenticated();
    }

    // Services collection: readable publicly (for storefront catalog), writable by authenticated users
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Activities collection: scoped to authenticated users
    match /activities/{activityId} {
      allow read, write: if isAuthenticated();
    }
  }
}
